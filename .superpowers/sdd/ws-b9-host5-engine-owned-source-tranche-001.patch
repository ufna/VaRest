+// Copyright 2014-2026 Vladimir Alyamkin. All Rights Reserved.
+#include "VaRestNativeOwnerHostSession.h"
+
+#if defined(VAREST_HOST_NATIVE_FRAME1) && VAREST_HOST_NATIVE_FRAME1
+#include "CoreGlobals.h"
+#include "HAL/PlatformProcess.h"
+#include "HAL/PlatformTLS.h"
+#include "Misc/CommandLine.h"
+#include "Misc/Fork.h"
+#include "Modules/ModuleManager.h"
+#include "VaRestSocketTransport.h"
+
+namespace VaRestHostSessionPrivate
+{
+// Existing Host/ABI status spellings, used as LOCAL refusals only. No producer
+// header/import or native result/call counter is created by this application.
+constexpr int32 Busy = 2, WrongThread = 5, Unestablished = 7, Stale = 11, Fork = 15, NoResult = 17;
+constexpr int32 ObservedReleaseUncertain = 19;
+}
+
+FVaRestNativeOwnerHostSession1::FVaRestNativeOwnerHostSession1() = default;
+// No auto-ack/cleanup. Qualified source must never destroy an unresolved graph;
+// returning early from a destructor would not preserve its members anyway.
+FVaRestNativeOwnerHostSession1::~FVaRestNativeOwnerHostSession1() = default;
+
+int32 FVaRestNativeOwnerHostSession1::ControlStatus1()
+{
+    if (!GIsGameThreadIdInitialized || FPlatformTLS::GetCurrentThreadId() != GGameThreadId || !IsInGameThread())
+        return VaRestHostSessionPrivate::WrongThread;
+    // Exact existing real-mode predicate, including initialization BEFORE the
+    // SupportsMultithreading/fork queries. No task-tag/early-default substitute.
+    if (!FCommandLine::IsInitialized() || !FPlatformProcess::SupportsMultithreading() || FForkProcessHelper::IsForkRequested()
+        || FForkProcessHelper::IsForkedChildProcess() || FForkProcessHelper::IsForkedMultithreadInstance())
+        return VaRestHostSessionPrivate::Fork;
+    return 0;
+}
+
+FVaRestNativeOwnerHostStep1 FVaRestNativeOwnerHostSession1::LocalStep1(EVaRestNativeOwnerHostOutcome1 Outcome, int32 Status)
+{
+    return {16, 1, static_cast<uint32>(Outcome), Status};
+}
+
+FVaRestNativeOwnerHostStep1 FVaRestNativeOwnerHostSession1::RetainedStep1() const
+{
+    const bool HasTerminal = bTerminalObserved && TerminalOperation != EOperation::None;
+    const int32 Status = HasTerminal && Terminal.ActualStatus != 0 ? Terminal.ActualStatus : VaRestHostSessionPrivate::Unestablished;
+    return LocalStep1(EVaRestNativeOwnerHostOutcome1::Retained, Status);
+}
+
+FVaRestNativeOwnerHostStep1 FVaRestNativeOwnerHostSession1::Observe1(EOperation Source, FVaRestNativeOwnerHostStep1 Result)
+{
+    const bool Valid = Result.Size == 16 && Result.Version == 1
+        && Result.Outcome <= static_cast<uint32>(EVaRestNativeOwnerHostOutcome1::Retained)
+        && (Result.Outcome != static_cast<uint32>(EVaRestNativeOwnerHostOutcome1::Complete) || Result.ActualStatus == 0);
+    if (!Valid) {
+        bStopRequested = true;
+        if (!bTerminalObserved) {
+            Terminal = LocalStep1(EVaRestNativeOwnerHostOutcome1::Retained, VaRestHostSessionPrivate::Unestablished);
+            TerminalOperation = Source; bTerminalObserved = true;
+        }
+        return RetainedStep1();
+    }
+    const bool TerminalResult = Result.Outcome == static_cast<uint32>(EVaRestNativeOwnerHostOutcome1::Refused)
+        || Result.Outcome == static_cast<uint32>(EVaRestNativeOwnerHostOutcome1::Retained)
+        || Result.ActualStatus == VaRestHostSessionPrivate::ObservedReleaseUncertain;
+    if (TerminalResult) {
+        bStopRequested = true;
+        if (!bTerminalObserved || (Result.ActualStatus == VaRestHostSessionPrivate::ObservedReleaseUncertain
+            && Terminal.ActualStatus != VaRestHostSessionPrivate::ObservedReleaseUncertain)) {
+            Terminal = Result; TerminalOperation = Source; bTerminalObserved = true;
+        }
+    }
+    // Actual observed19 is sticky Host history, not a new native call/result.
+    if (bTerminalObserved && Terminal.ActualStatus == VaRestHostSessionPrivate::ObservedReleaseUncertain)
+        return RetainedStep1();
+    return Result;
+}
+
+bool FVaRestNativeOwnerHostSession1::IsFinishRequested1() const
+{
+    return bStopRequested || Phase != EPhase::Active;
+}
+
+bool FVaRestNativeOwnerHostSession1::HasAttemptedStart1() const
+{
+    return bStartDispatched;
+}
+
+FVaRestNativeOwnerHostStep1 FVaRestNativeOwnerHostSession1::StartAfterEngineInit1()
+{
+    const int32 Role = ControlStatus1();
+    if (Role != 0) {
+        const FVaRestNativeOwnerHostStep1 Refusal = LocalStep1(EVaRestNativeOwnerHostOutcome1::Refused, Role);
+        return Role == VaRestHostSessionPrivate::WrongThread ? Refusal : Observe1(EOperation::Start, Refusal);
+    }
+    if (Phase != EPhase::Unattempted || Operation != EOperation::None)
+        return bTerminalObserved ? RetainedStep1() : LocalStep1(EVaRestNativeOwnerHostOutcome1::Refused, VaRestHostSessionPrivate::Stale);
+    Operation = EOperation::Bind;
+    // Only an already normally loaded exact revision2 module is eligible. No
+    // load/cast/name can establish provenance; that remains an actual H premise.
+    WebSocket = FModuleManager::GetModulePtr<IVaRestNativeOwnerHost1>(TEXT("VaRestWebSocket"));
+    if (!WebSocket) {
+        Operation = EOperation::None; Phase = EPhase::Retained; bStopRequested = true;
+        return Observe1(EOperation::Bind, LocalStep1(EVaRestNativeOwnerHostOutcome1::Refused, VaRestHostSessionPrivate::Unestablished));
+    }
+    Transport = VaRest::WebSocket::GetDefaultTransport(); // SAME DefaultSlot, no Service/context/thread construction.
+    Operation = EOperation::None;
+    if (bStopRequested) {
+        Phase = EPhase::Retained;
+        return Observe1(EOperation::Bind, LocalStep1(EVaRestNativeOwnerHostOutcome1::Refused, VaRestHostSessionPrivate::Stale));
+    }
+    const TSharedPtr<IVaRestSocketTransport, ESPMode::ThreadSafe> HeldTransport = Transport;
+    (void)HeldTransport; // Actual graph pin through the WHOLE WS return.
+    Phase = EPhase::Starting; Operation = EOperation::Start;
+    bStartDispatched = true; // Real call-boundary history BEFORE possible reentrant stop.
+    const FVaRestNativeOwnerHostStep1 Raw = WebSocket->StartNativeOwnerSession1();
+    Operation = EOperation::None;
+    const FVaRestNativeOwnerHostStep1 Result = Observe1(EOperation::Start, Raw);
+    if (!bStopRequested && Result.Outcome == static_cast<uint32>(EVaRestNativeOwnerHostOutcome1::Complete) && Result.ActualStatus == 0)
+        Phase = EPhase::Active;
+    else { bStopRequested = true; Phase = EPhase::FinishRequested; }
+    return Result;
+}
+
+FVaRestNativeOwnerHostStep1 FVaRestNativeOwnerHostSession1::FrameAfterEngineTick1()
+{
+    const int32 Role = ControlStatus1();
+    if (Role != 0) {
+        const FVaRestNativeOwnerHostStep1 Refusal = LocalStep1(EVaRestNativeOwnerHostOutcome1::Refused, Role);
+        return Role == VaRestHostSessionPrivate::WrongThread ? Refusal : Observe1(EOperation::Frame, Refusal);
+    }
+    if (Operation != EOperation::None)
+        return bTerminalObserved ? RetainedStep1() : LocalStep1(EVaRestNativeOwnerHostOutcome1::Refused, VaRestHostSessionPrivate::Busy);
+    if (Phase != EPhase::Active || bStopRequested || !WebSocket || !Transport.IsValid())
+        return bTerminalObserved ? RetainedStep1() : LocalStep1(EVaRestNativeOwnerHostOutcome1::Refused, VaRestHostSessionPrivate::Stale);
+    const TSharedPtr<IVaRestSocketTransport, ESPMode::ThreadSafe> HeldTransport = Transport;
+    (void)HeldTransport;
+    Operation = EOperation::Frame;
+    const FVaRestNativeOwnerHostStep1 Raw = WebSocket->PumpNativeOwnerSession1();
+    Operation = EOperation::None;
+    const FVaRestNativeOwnerHostStep1 Result = Observe1(EOperation::Frame, Raw);
+    if (bStopRequested) Phase = EPhase::FinishRequested;
+    return Result; // Existing WS Enter/one poll/Leave has FULLY returned.
+}
+
+void FVaRestNativeOwnerHostSession1::SetFinishPhase1(const FVaRestNativeOwnerHostStep1& Result)
+{
+    if (Result.ActualStatus == VaRestHostSessionPrivate::ObservedReleaseUncertain
+        || Result.Outcome == static_cast<uint32>(EVaRestNativeOwnerHostOutcome1::Retained)
+        || Result.Outcome == static_cast<uint32>(EVaRestNativeOwnerHostOutcome1::Refused))
+        Phase = EPhase::Retained;
+    else if (Result.Outcome == static_cast<uint32>(EVaRestNativeOwnerHostOutcome1::Complete) && Result.ActualStatus == 0)
+        Phase = EPhase::WsCompleteGlobalUnestablished;
+    else Phase = EPhase::Finishing;
+}
+
+FVaRestNativeOwnerHostStep1 FVaRestNativeOwnerHostSession1::RequestFinish1()
+{
+    const int32 Role = ControlStatus1();
+    if (Role != 0) {
+        const FVaRestNativeOwnerHostStep1 Refusal = LocalStep1(EVaRestNativeOwnerHostOutcome1::Refused, Role);
+        return Role == VaRestHostSessionPrivate::WrongThread ? Refusal : Observe1(EOperation::Finish, Refusal);
+    }
+    bStopRequested = true;
+    if (!bStartDispatched || !WebSocket)
+        return bTerminalObserved ? RetainedStep1() : LocalStep1(EVaRestNativeOwnerHostOutcome1::Refused, VaRestHostSessionPrivate::NoResult);
+    if (Operation != EOperation::None) {
+        if (Operation == EOperation::Start && !bStopCutInProgress) {
+            bStopCutInProgress = true;
+            const TSharedPtr<IVaRestSocketTransport, ESPMode::ThreadSafe> HeldTransport = Transport;
+            (void)HeldTransport;
+            // In the genuine WS InEntry/InCreate interval this executes the
+            // existing Shutdown/permit cut BEFORE its BUSY return. This nested
+            // stop-cut is NOT first-join completion; outer control still finishes.
+            const FVaRestNativeOwnerHostStep1 Cut = WebSocket->FinishNativeOwnerSession1();
+            bStopCutInProgress = false;
+            return Observe1(EOperation::Finish, Cut);
+        }
+        return bTerminalObserved ? RetainedStep1() : LocalStep1(EVaRestNativeOwnerHostOutcome1::Pending, VaRestHostSessionPrivate::Busy);
+    }
+    if (bFirstFinishReturned) return AdvanceFinish1();
+    const TSharedPtr<IVaRestSocketTransport, ESPMode::ThreadSafe> HeldTransport = Transport;
+    (void)HeldTransport;
+    Phase = EPhase::Finishing; Operation = EOperation::Finish;
+    const FVaRestNativeOwnerHostStep1 Raw = WebSocket->FinishNativeOwnerSession1();
+    Operation = EOperation::None; bFirstFinishReturned = true;
+    const FVaRestNativeOwnerHostStep1 Result = Observe1(EOperation::Finish, Raw);
+    SetFinishPhase1(Result);
+    return Result;
+}
+
+FVaRestNativeOwnerHostStep1 FVaRestNativeOwnerHostSession1::AdvanceFinish1()
+{
+    const int32 Role = ControlStatus1();
+    if (Role != 0) {
+        const FVaRestNativeOwnerHostStep1 Refusal = LocalStep1(EVaRestNativeOwnerHostOutcome1::Refused, Role);
+        return Role == VaRestHostSessionPrivate::WrongThread ? Refusal : Observe1(EOperation::Advance, Refusal);
+    }
+    if (!bStartDispatched || !bStopRequested || !WebSocket)
+        return LocalStep1(EVaRestNativeOwnerHostOutcome1::Refused, VaRestHostSessionPrivate::NoResult);
+    if (Operation != EOperation::None || !bFirstFinishReturned)
+        return bTerminalObserved ? RetainedStep1() : LocalStep1(EVaRestNativeOwnerHostOutcome1::Pending, VaRestHostSessionPrivate::Busy);
+    if (Phase == EPhase::WsCompleteGlobalUnestablished || Phase == EPhase::Retained)
+        return RetainedStep1(); // NO further WS calls; global duty is NOT discharged.
+    const TSharedPtr<IVaRestSocketTransport, ESPMode::ThreadSafe> HeldTransport = Transport;
+    (void)HeldTransport;
+    Operation = EOperation::Advance;
+    const FVaRestNativeOwnerHostStep1 Raw = WebSocket->AdvanceNativeOwnerFinish1();
+    Operation = EOperation::None;
+    const FVaRestNativeOwnerHostStep1 Result = Observe1(EOperation::Advance, Raw);
+    SetFinishPhase1(Result);
+    return Result; // Actual WS predicates alone exclude a first/repeated Kill.
+}
+#endif
