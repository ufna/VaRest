+// Target-private ordinary C++ boundary. A shared object owns no DLL/Core/O pin.
+// Only the actual initialized physical GT owns these fields. Launch's lexical
+// interval and all H/code/provider/return premises must precede native Start.
+class VARESTHOST_API FVaRestNativeOwnerHostSession1 final
+{
+public:
+    FVaRestNativeOwnerHostSession1();
+    ~FVaRestNativeOwnerHostSession1();
+    FVaRestNativeOwnerHostSession1(const FVaRestNativeOwnerHostSession1&) = delete;
+    FVaRestNativeOwnerHostSession1& operator=(const FVaRestNativeOwnerHostSession1&) = delete;
+
+    FVaRestNativeOwnerHostStep1 StartAfterEngineInit1();
+    FVaRestNativeOwnerHostStep1 FrameAfterEngineTick1();
+    FVaRestNativeOwnerHostStep1 RequestFinish1();
+    FVaRestNativeOwnerHostStep1 AdvanceFinish1();
+    // GT-only source history, never H/no-owner/exit permission. Launch has
+    // already checked the physical GT and real nonfork mode before acquiring.
+    bool IsFinishRequested1() const;
+    bool HasAttemptedStart1() const;
+
+private:
+    enum class EPhase : uint8 { Unattempted, Starting, Active, FinishRequested, Finishing, WsCompleteGlobalUnestablished, Retained };
+    enum class EOperation : uint8 { None, Bind, Start, Frame, Finish, Advance };
+    static int32 ControlStatus1();
+    static FVaRestNativeOwnerHostStep1 LocalStep1(EVaRestNativeOwnerHostOutcome1 Outcome, int32 Status);
+    FVaRestNativeOwnerHostStep1 Observe1(EOperation Source, FVaRestNativeOwnerHostStep1 Result);
+    FVaRestNativeOwnerHostStep1 RetainedStep1() const;
+    void SetFinishPhase1(const FVaRestNativeOwnerHostStep1& Result);
+
+    EPhase Phase = EPhase::Unattempted;
+    EOperation Operation = EOperation::None;
+    EOperation TerminalOperation = EOperation::None;
+    bool bStartDispatched = false;
+    bool bStopRequested = false;
+    bool bStopCutInProgress = false;
+    bool bFirstFinishReturned = false;
+    bool bTerminalObserved = false;
+    FVaRestNativeOwnerHostStep1 Terminal = {16, 1, static_cast<uint32>(EVaRestNativeOwnerHostOutcome1::Retained), 7};
+    IVaRestNativeOwnerHost1* WebSocket = nullptr;
+    TSharedPtr<IVaRestSocketTransport, ESPMode::ThreadSafe> Transport;
+};
+
+#endif
