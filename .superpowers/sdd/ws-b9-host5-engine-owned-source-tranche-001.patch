+// Copyright Epic Games, Inc. All Rights Reserved.
+#pragma once
+
+#if defined(VAREST_HOST_NATIVE_FRAME1) && VAREST_HOST_NATIVE_FRAME1
+#include "CoreTypes.h"
+#include "Modules/ModuleManager.h"
+#include "Templates/SharedPointer.h"
+
+// Ordinary Engine-owned control result, NOT the native producer or WS ABI.
+// Outcome spellings: Complete=0, Pending=1, Refused=2, Retained=3.
+// Neither this result nor an opaque owner certifies H, code lifetime or exit.
+struct FVaRestLaunchHostStep1
+{
+    uint32 Size;
+    uint32 Version;
+    uint32 Outcome;
+    int32 ActualStatus;
+};
+static_assert(sizeof(FVaRestLaunchHostStep1) == 16);
+static_assert(alignof(FVaRestLaunchHostStep1) == 4);
+
+// One inheritance chain preserves FDefaultGameModuleImpl's game-module role.
+// The already normally loaded exact module/class/vtable/code interval must be
+// qualified BEFORE GetModulePtr's static cast or any virtual dispatch.
+class IVaRestLaunchHostControl1 : public FDefaultGameModuleImpl
+{
+public:
+    // Same concrete Startup-created Session/controller; ownership only.
+    // Never dereference/cast/adopt this void pointer or pass it as authority.
+    virtual TSharedPtr<void, ESPMode::ThreadSafe> CopySessionOwner1() const = 0;
+    virtual FVaRestLaunchHostStep1 StartAfterEngineInit1() = 0;
+    virtual FVaRestLaunchHostStep1 FrameAfterEngineTick1() = 0;
+    virtual FVaRestLaunchHostStep1 RequestFinish1() = 0;
+    virtual FVaRestLaunchHostStep1 AdvanceFinish1() = 0;
+    // Strict physical-GT/real-mode/same-live-owner PRECONDITIONS, including
+    // cleanup queries. No unsupported-role/missing-owner bool sentinel exists.
+    virtual bool IsFinishRequested1() const = 0;
+    virtual bool HasAttemptedStart1() const = 0;
+};
+#endif
