{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "M5-source-candidate",
  "FriendlyName": "VaRest M5 isolated smoke fixture",
  "Description": "Opt-in M5 fixture: settings-only proof B and separate Core-only module-stop witness. Proof A and whole Task 14 qualification remain independent.",
  "EnabledByDefault": false,
  "CanContainContent": true,
  "SupportedTargetPlatforms": [
    "Linux"
  ],
  "Modules": [
    {
      "Name": "VaRestM5StopWitness",
      "Type": "Runtime",
      "LoadingPhase": "PostConfigInit",
      "PlatformAllowList": [
        "Linux"
      ]
    },
    {
      "Name": "VaRestM5Smoke",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "PlatformAllowList": [
        "Linux"
      ]
    },
    {
      "Name": "VaRestM5SmokeEditor",
      "Type": "Editor",
      "LoadingPhase": "Default",
      "PlatformAllowList": [
        "Linux"
      ]
    }
  ],
  "Plugins": [
    {
      "Name": "VaRest",
      "Enabled": true
    }
  ]
}
