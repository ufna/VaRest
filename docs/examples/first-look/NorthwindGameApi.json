{
  "openapi": "3.0.3",
  "info": {
    "title": "Northwind Game API",
    "version": "1.0.0",
    "description": "Local demonstration of actual VaRest OpenAPI import and generated types."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18423",
      "description": "Local demo"
    }
  ],
  "paths": {
    "/profile": {
      "get": {
        "operationId": "GetPlayerProfile",
        "summary": "Read player profile",
        "tags": [
          "Players"
        ],
        "responses": {
          "200": {
            "description": "Profile found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerProfile"
                }
              }
            }
          }
        }
      }
    },
    "/inventory": {
      "get": {
        "operationId": "GetInventory",
        "summary": "List inventory items",
        "tags": [
          "Inventory"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Inventory",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InventoryItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/matches": {
      "post": {
        "operationId": "CreateMatch",
        "summary": "Create a multiplayer match",
        "tags": [
          "Matches"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMatchRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Match created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Match"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PlayerProfile": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "level"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "displayName": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "format": "int32"
          },
          "online": {
            "type": "boolean"
          },
          "guild": {
            "type": "string"
          }
        }
      },
      "InventoryItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "rarity": {
            "type": "string",
            "enum": [
              "Common",
              "Rare",
              "Epic",
              "Legendary"
            ]
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CreateMatchRequest": {
        "type": "object",
        "properties": {
          "map": {
            "type": "string"
          },
          "maxPlayers": {
            "type": "integer",
            "format": "int32"
          },
          "ranked": {
            "type": "boolean"
          }
        }
      },
      "Match": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "Waiting",
              "Running",
              "Finished"
            ]
          },
          "players": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  }
}
